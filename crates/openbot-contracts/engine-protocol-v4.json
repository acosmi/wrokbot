{
  "schema": "openbot-engine-protocol",
  "version": 4,
  "release_epoch": 5,
  "max_boot_bytes": 4096,
  "max_control_frame_bytes": 65536,
  "max_image_bytes": 8388608,
  "frame_magic": "OBFRAME2",
  "frame_hello_magic": "OBFHELLO",
  "frame_fixed_header_bytes": 76,
  "roles": [
    "browser_computer",
    "sandboxed_component"
  ],
  "commands": [
    "start",
    "input",
    "frame_ack",
    "screencast",
    "stop",
    "shutdown"
  ],
  "events": [
    "hello",
    "ready",
    "started",
    "input_applied",
    "screencast_state",
    "stopped",
    "shutdown_complete",
    "error"
  ],
  "input_kinds": [
    "mouse_move",
    "mouse_down",
    "mouse_up",
    "wheel",
    "key_down",
    "raw_key_down",
    "key_up",
    "insert_text"
  ],
  "image_formats": [
    "jpeg"
  ],
  "screencast": {
    "format": "jpeg",
    "quality": 70,
    "max_width": 1280,
    "max_height": 800,
    "every_nth_frame": 1,
    "max_frames_in_flight": 1,
    "send_last_frame": true
  }
}
