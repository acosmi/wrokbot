  "result_class_vocabulary": {
    "values": [
      "true",
      "false",
      "error"
    ],
    "mapping_note": "与 v3 §8.3 的三类对齐。上游 server/src/computer/policy.ts::matches 把\"抛错\"与\"返回非布尔\"归入同一条 fail-closed 路径，因此本文件把非布尔结果记为 error，并在 engine_raw.kind = \"non-boolean\" 里保留引擎真实返回，避免两种失效模式被压成一个字符串而不可区分。"
  },
  "policy_layer_semantics": {
    "source": "server/src/computer/policy.ts::evaluateActionPolicy",
    "rules": [
      "deny 先于 allow；deny 命中即拒绝，whatever allow says。",
      "deny 侧 onError=true：result_class=error 的表达式判为\"拒绝\"。",
      "allow 侧 onError=false：result_class=error 的表达式判为\"不放行\"。",
      "result_class=false 是真答案，不得读成 broken。",
      "mode=dry-run 只改 forward，不改 allowed / matched / source。",
      "policy 为 null/undefined，或 allow 为空列表，一律 source=\"default\" 且 allowed=false。"
    ]
  },
  "measured_findings": [
    {
      "id": "F-CEL-1",
      "severity": "blocking-for-migration",
      "claim": "cel-js 0.8.2 没有任何字符串方法：contains / startsWith / endsWith / matches 的方法形式一律抛 \"Unknown method: <名>\"。",
      "evidence_entries": [
        "method-form-contains",
        "method-form-startswith",
        "method-form-endswith",
        "method-form-matches"
      ],
      "positive_control": [
        "global-form-contains",
        "global-form-matches"
      ],
      "rust_risk": "Rust cel 0.14.3 实现标准 CEL 字符串方法，同一表达式会正常求值 ⇒ 结果类别 error→true/false，deny 规则的语义整条翻转。v3 §8.3 差异 1。"
    },
    {
      "id": "F-CEL-2",
      "severity": "blocking-for-migration",
      "claim": "上游注入的两个全局函数都是大小写不敏感：contains 双向 toLowerCase，matches 强制 RegExp 的 i 标志。",
      "evidence_entries": [
        "contains-case-insensitive-haystack",
        "contains-case-insensitive-needle",
        "global-matches-case-insensitive"
      ],
      "positive_control": [
        "contains-miss"
      ],
      "rust_risk": "标准 CEL 的同名方法大小写敏感。Rust 侧注册全局函数时若沿用标准语义，\"never click submit\" 不再命中 \"SUBMIT NOW\"，属悄悄放宽。"
    },
    {
      "id": "F-CEL-3",
      "severity": "blocking-for-migration",
      "claim": "cel-js 0.8.2 的 && 只从左向右短路；|| 完全不短路，左操作数为 true 时仍会求值右操作数并因缺标识符抛错。",
      "evidence_entries": [
        "and-shortcircuit-left-false",
        "and-no-reverse-shortcircuit",
        "or-no-shortcircuit-left-true",
        "or-no-shortcircuit-right-true"
      ],
      "positive_control": [
        "key-guarded-on-navigation"
      ],
      "rust_risk": "标准 CEL 对 || 做 commutative 短路。一条 \"true || key == \\\"Enter\\\"\" 形状的规则在上游是 error（deny 侧=拒绝），在 Rust 侧会变 true——同样是拒绝；但 allow 侧同一条会从\"不放行\"变成\"放行\"。类别翻转必须逐条进迁移报告。"
    },
    {
      "id": "F-CEL-4",
      "severity": "blocking-for-migration",
      "claim": "读取 context 里不存在的标识符或不存在的嵌套字段一律抛错，不返回 null。",
      "evidence_entries": [
        "contains-missing-element",
        "key-unguarded-on-navigation",
        "intent-missing-on-plain-click",
        "probe-absent-nested-field-read",
        "non-boolean-unknown-root"
      ],
      "positive_control": [
        "contains-empty-element-name",
        "probe-has-absent-field"
      ],
      "rust_risk": "Rust 侧若把缺字段求值为 null 或空值，deny 规则从 error（拒绝）变 false（放行）。上游 gateway 刻意给 MCP / command context 塞满空串字段就是为了区分\"存在且为空\"与\"不存在\"，Rust 侧必须原样保留这个区分。"
    },
    {
      "id": "F-CEL-5",
      "severity": "documented-upstream-inconsistency",
      "claim": "上游 server/tests/computer-policy.test.ts 把 \"repeat.count\" 标注为 \"a number\"（非布尔），实测它抛 Identifier not found（throw）。",
      "evidence_entries": [
        "non-boolean-unknown-root"
      ],
      "positive_control": [
        "non-boolean-bare-field"
      ],
      "rust_risk": "两条路径在 policy 层同归 fail-closed，所以上游测试恒绿、注释错了也没人发现。Rust 侧照抄注释就会把它分到错误的类别。"
    },
    {
      "id": "F-CEL-6",
      "severity": "audit-payload-risk",
      "claim": "cel-js 的 \"Identifier not found\" 错误消息把**整个 context 的 JSON**拼进消息体，而上游 server/src/computer/policy.ts::matches 用 console.error 把 String(error) 原样打日志。",
      "evidence_entries": [
        "contains-missing-element",
        "key-unguarded-on-navigation"
      ],
      "positive_control": [
        "method-form-contains"
      ],
      "rust_risk": "一条写错的 deny 规则会把 page.url、command、file.path 逐字写进服务器日志，与 v3 §8.6 的 payload 字段 allowlist 冲突。Rust 侧的错误消息必须只带表达式与失败原因，不带 context 内容；本条不是 parity 项，是**明确不照译**的上游缺陷（v3 §2.4 类）。"
    }
