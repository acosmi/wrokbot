    "messages": [
      { "id": "msg-general-0001", "thread_id": "thr-general", "seq": 1, "author_kind": "user", "author_id": "usr-ada", "body": "I have moved the order questions to the order desk.", "created_at": "2025-12-31T18:12:00Z" },
      { "id": "msg-orders-0001", "thread_id": "thr-orders", "seq": 1, "author_kind": "user", "author_id": "usr-bo", "body": "Can you check order 4471 and tell me whether the total is right?", "created_at": "2025-12-31T22:30:00Z" },
      { "id": "msg-orders-0002", "thread_id": "thr-orders", "seq": 2, "author_kind": "agent", "author_id": "risk-analyst", "body": "Opening the order page now.", "created_at": "2025-12-31T22:31:00Z" },
      { "id": "msg-orders-0003", "thread_id": "thr-orders", "seq": 3, "author_kind": "agent", "author_id": "risk-analyst", "body": "The total reads **1 284.00 EUR** across 3 line items:\n\n| Item | Qty | Line total |\n| --- | --- | --- |\n| Widget A | 2 | 240.00 |\n| Widget B | 1 | 44.00 |\n| Service | 1 | 1000.00 |\n\nThe arithmetic is right.", "created_at": "2025-12-31T22:36:00Z", "render_note": "覆盖 §6.4 的 markdown 表格与粗体渲染。" },
      { "id": "msg-orders-0004", "thread_id": "thr-orders", "seq": 4, "author_kind": "user", "author_id": "usr-bo", "body": "Good. Submit it.", "created_at": "2025-12-31T22:37:00Z" },
      { "id": "msg-orders-0005", "thread_id": "thr-orders", "seq": 5, "author_kind": "agent", "author_id": "risk-analyst", "body": "This deployment's policy does not allow that: “Submit order” on example.com is blocked by the rule `(intent == \"activate\" && contains(element.name, \"submit\")) || ((tool.name == \"computer_key\" || tool.name == \"computer_type\") && key == \"Enter\")`.", "created_at": "2025-12-31T22:41:00Z", "render_note": "文案逐字取自 server/src/computer/policy.ts::describeRefusal 的输出形状，覆盖行内代码渲染与长规则换行。" },
      { "id": "msg-orders-0006", "thread_id": "thr-orders", "seq": 6, "author_kind": "agent", "author_id": "risk-analyst", "body": "```json\n{\n  \"order\": 4471,\n  \"total\": \"1284.00\",\n  \"currency\": \"EUR\"\n}\n```", "created_at": "2025-12-31T22:41:30Z", "render_note": "覆盖 §6.4 的代码块渲染与等宽字体。" },
      { "id": "msg-support-0001", "thread_id": "thr-support", "seq": 1, "author_kind": "user", "author_id": "usr-chen", "body": "帮我总结一下今天的工单。", "created_at": "2025-12-31T12:50:00Z" },
      { "id": "msg-support-0002", "thread_id": "thr-support", "seq": 2, "author_kind": "agent", "author_id": "knowledge", "body": "今天共有 3 张工单，其中 1 张待人工确认。详见 https://tickets.example.com/today", "created_at": "2025-12-31T13:05:00Z", "render_note": "覆盖 §6.4 的裸链接自动识别与 §8.6 CJK 与拉丁混排换行。" },
      { "id": "msg-support-0003", "thread_id": "thr-support", "seq": 3, "author_kind": "system", "author_id": null, "body": "陈墨 记住了一条偏好。", "created_at": "2025-12-31T13:06:00Z" }
