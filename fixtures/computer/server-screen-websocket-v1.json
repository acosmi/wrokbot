    "firstFrameSequenceMatchesEngine": true,
    "jpegMagicMatches": true,
    "boundedShutdown": true
  },
  "evidenceBoundary": {
    "typedApplicationTicket": true,
    "serverSameOriginWebSocket": true,
    "realEngineToServerBinaryFrame": true,
    "productionServerHubAndPortComposition": true,
    "productionManagerAttachesEngineSource": false,
    "postgresSessionCookieBrowser": false,
    "externalTlsTermination": false,
    "desktopLoopbackWebSocket": false,
    "viewerInputOverWebSocket": false,
    "bandwidthOrIdleLimit": false,
    "lastViewerStopsScreencastWithinTwoSeconds": false,
    "windowsRuntime": false,
    "linuxRunscRuntime": false
  }
